NODE_ENV=production
PORT=5173
CLIENT_ORIGIN=https://your-frontend.example.com

SESSION_SECRET=replace-with-a-long-random-secret
SESH_EXPIRE_MS=86400000
DB_HOST=localhost
DB_PORT=3306
DB_USER=carwash_app
DB_PASSWORD=replace-with-database-password
DB_NAME=carwash_database

CAR_DATA_API_RESOURCE=replace-with-resource-id
CAR_DATA_API_URL=https://data.gov.il/api/3/action/datastore_search

# Verification email SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com